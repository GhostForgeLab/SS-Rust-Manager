#!/usr/bin/env bash
set -uo pipefail

SERVICE="shadowsocks-rust.service"
CONFIG="/etc/shadowsocks-rust/config.json"
BACKUP_DIR="/var/backups/shadowsocks-rust"
BIN="/usr/local/bin/ssserver"

pause() { read -r -p "按回车继续..." _; }
hr() { printf '%s\n' "================================"; }
need_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "请使用 root 权限运行 ssmenu"; exit 1; }; }

json_get() {
  local key="$1"
  python3 - "$CONFIG" "$key" <<'PY' 2>/dev/null
import json, sys
try:
    d=json.load(open(sys.argv[1],encoding="utf-8"))
    v=d.get(sys.argv[2],"")
    if isinstance(v,bool): print(str(v).lower())
    elif v is not None: print(v)
except Exception:
    pass
PY
}

json_set() {
  local key="$1" value="$2" type="${3:-str}"
  python3 - "$CONFIG" "$key" "$value" "$type" <<'PY'
import json, sys, os, tempfile
p,k,v,t=sys.argv[1:5]
with open(p,encoding="utf-8") as f: d=json.load(f)
if t=="int": v=int(v)
elif t=="bool": v=(v.lower()=="true")
elif t=="null": v=None
d[k]=v
fd,tmp=tempfile.mkstemp(prefix=".config.",dir=os.path.dirname(p))
os.close(fd)
with open(tmp,"w",encoding="utf-8") as f:
    json.dump(d,f,ensure_ascii=False,indent=2); f.write("\n")
os.chmod(tmp,0o600)
os.replace(tmp,p)
PY
}

json_del() {
  local key="$1"
  python3 - "$CONFIG" "$key" <<'PY'
import json, sys, os, tempfile
p,k=sys.argv[1:3]
with open(p,encoding="utf-8") as f: d=json.load(f)
d.pop(k,None)
fd,tmp=tempfile.mkstemp(prefix=".config.",dir=os.path.dirname(p)); os.close(fd)
with open(tmp,"w",encoding="utf-8") as f:
    json.dump(d,f,ensure_ascii=False,indent=2); f.write("\n")
os.chmod(tmp,0o600); os.replace(tmp,p)
PY
}

backup_config() {
  mkdir -p "$BACKUP_DIR"
  [[ -f "$CONFIG" ]] || { echo "配置不存在：$CONFIG"; return 1; }
  local b="$BACKUP_DIR/config-$(date +%Y%m%d-%H%M%S).json"
  cp -a "$CONFIG" "$b"
  echo "备份完成：$b"
}

status_service() { systemctl status "$SERVICE" --no-pager -l || true; }
start_service() { systemctl start "$SERVICE" && echo "已启动。"; }
stop_service() { systemctl stop "$SERVICE" && echo "已停止。"; }
restart_service() { systemctl restart "$SERVICE" && echo "已重启。"; }

view_config() {
  [[ -f "$CONFIG" ]] && cat "$CONFIG" || echo "配置不存在：$CONFIG"
}

edit_config() {
  backup_config >/dev/null 2>&1 || true
  if command -v nano >/dev/null 2>&1; then nano "$CONFIG"; else "${EDITOR:-vi}" "$CONFIG"; fi
  python3 -m json.tool "$CONFIG" >/dev/null 2>&1 || { echo "JSON 格式错误，未重启服务。"; return; }
  systemctl restart "$SERVICE" && echo "配置保存并重启成功。"
}

public_ip4() { curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null || true; }
public_ip6() { curl -6 -fsS --max-time 5 https://api64.ipify.org 2>/dev/null || true; }

show_ss_url() {
  [[ -f "$CONFIG" ]] || { echo "配置不存在"; return; }
  local port method password host userinfo url
  port="$(json_get server_port)"
  method="$(json_get method)"
  password="$(json_get password)"
  host="$(public_ip4)"
  [[ -n "$host" ]] || host="$(hostname -I 2>/dev/null | awk '{print $1}')"
  [[ -n "$host" ]] || { echo "无法获取服务器 IP"; return; }

  userinfo="$(python3 - "$method" "$password" <<'PY'
import base64,sys
s=f"{sys.argv[1]}:{sys.argv[2]}".encode()
print(base64.urlsafe_b64encode(s).decode().rstrip("="))
PY
)"
  url="ss://${userinfo}@${host}:${port}"
  echo
  echo "$url"
  echo
  if command -v qrencode >/dev/null 2>&1; then
    qrencode -t ANSIUTF8 "$url" || true
  fi
}

show_logs() { journalctl -u "$SERVICE" -f -n 80; }
show_version() { "$BIN" --version 2>/dev/null || echo "ssserver 未安装"; }

check_update() {
  /usr/local/bin/ssupdate check
  echo
  read -r -p "是否下载安装官方最新版？[y/N]：" a
  if [[ "${a,,}" == "y" ]]; then /usr/local/bin/ssupdate update; fi
}

restore_config() {
  mkdir -p "$BACKUP_DIR"
  mapfile -t files < <(find "$BACKUP_DIR" -maxdepth 1 -type f -name 'config-*.json' -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d' ' -f2- | head -n 20)
  ((${#files[@]})) || { echo "没有配置备份。"; return; }
  echo "最近备份："
  local i
  for i in "${!files[@]}"; do printf "%2d. %s\n" "$((i+1))" "${files[$i]}"; done
  read -r -p "选择序号：" n
  [[ "$n" =~ ^[0-9]+$ ]] && ((n>=1 && n<=${#files[@]})) || { echo "选择无效"; return; }
  backup_config >/dev/null 2>&1 || true
  cp -a "${files[$((n-1))]}" "$CONFIG"
  chmod 600 "$CONFIG"
  systemctl restart "$SERVICE" && echo "恢复完成并已重启服务。"
}

autostart_menu() {
  echo "当前：$(systemctl is-enabled "$SERVICE" 2>/dev/null || true)"
  echo "1. 开启开机自启"
  echo "2. 关闭开机自启"
  read -r -p "选择：" n
  case "$n" in
    1) systemctl enable "$SERVICE" && echo "已开启" ;;
    2) systemctl disable "$SERVICE" && echo "已关闭" ;;
  esac
}

self_check() {
  local fail=0 warn=0
  echo "=== Shadowsocks Rust 一键自检 ==="
  for c in ssserver python3 curl jq systemctl; do
    if command -v "$c" >/dev/null 2>&1; then echo "[ OK ] $c"; else echo "[FAIL] 缺少 $c"; fail=$((fail+1)); fi
  done

  if [[ -f "$CONFIG" ]]; then
    echo "[ OK ] 配置文件存在：$CONFIG"
    if python3 -m json.tool "$CONFIG" >/dev/null 2>&1; then echo "[ OK ] JSON 格式正确"; else echo "[FAIL] JSON 格式错误"; fail=$((fail+1)); fi
  else
    echo "[FAIL] 配置文件不存在"; fail=$((fail+1))
  fi

  if [[ -f "/etc/systemd/system/$SERVICE" ]]; then echo "[ OK ] systemd 服务文件存在"; else echo "[FAIL] systemd 服务文件不存在"; fail=$((fail+1)); fi
  if systemctl is-active --quiet "$SERVICE"; then echo "[ OK ] 服务 active"; else echo "[FAIL] 服务未运行"; fail=$((fail+1)); fi
  if systemctl is-enabled --quiet "$SERVICE"; then echo "[ OK ] 已开启开机自启"; else echo "[WARN] 未开启开机自启"; warn=$((warn+1)); fi

  local port
  port="$(json_get server_port)"
  if [[ -n "$port" ]] && ss -lntup 2>/dev/null | grep -qE "[:.]${port}\b"; then
    echo "[ OK ] 端口 $port 正在监听"
  else
    echo "[WARN] 未确认端口 ${port:-?} 的监听状态"; warn=$((warn+1))
  fi

  echo
  echo "自检结果：$fail 个失败，$warn 个警告。"
  ((fail==0)) && echo "结论：核心检查通过。" || echo "结论：存在需要处理的问题。"
}

connection_info() {
  echo "ssserver：$("$BIN" --version 2>/dev/null | head -n1 || echo 未安装)"
  echo "服务状态：$(systemctl is-active "$SERVICE" 2>/dev/null || true)"
  echo "IPv4：$(public_ip4)"
  echo "IPv6：$(public_ip6)"
  echo "端口：$(json_get server_port)"
  echo "加密：$(json_get method)"
  echo "模式：$(json_get mode)"
  echo "出站绑定：$(json_get outbound_bind_addr)"
}

choose_outbound() {
  [[ -f "$CONFIG" ]] || { echo "配置不存在"; return; }
  echo "当前 outbound_bind_addr：$(json_get outbound_bind_addr)"
  echo "1. 自动（删除绑定）"
  echo "2. 强制 IPv4 出站"
  echo "3. 强制 IPv6 出站"
  read -r -p "选择：" n
  local addr
  case "$n" in
    1)
      backup_config >/dev/null 2>&1 || true
      json_del outbound_bind_addr
      ;;
    2)
      addr="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')"
      [[ -n "$addr" ]] || { echo "未检测到可用 IPv4 出站地址"; return; }
      backup_config >/dev/null 2>&1 || true
      json_set outbound_bind_addr "$addr"
      ;;
    3)
      addr="$(ip -6 route get 2606:4700:4700::1111 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')"
      [[ -n "$addr" ]] || { echo "未检测到可用 IPv6 出站地址"; return; }
      backup_config >/dev/null 2>&1 || true
      json_set outbound_bind_addr "$addr"
      ;;
    *) echo "选择无效"; return ;;
  esac
  systemctl restart "$SERVICE" && echo "出站设置已应用。"
}

bbr_menu() {
  echo "当前拥塞控制：$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)"
  if sysctl net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -qw bbr; then
    echo "内核支持 BBR。"
  else
    modprobe tcp_bbr 2>/dev/null || true
  fi
  read -r -p "是否开启/应用 BBR + fq？[y/N]：" a
  [[ "${a,,}" == "y" ]] || return
  cat > /etc/sysctl.d/99-ss-rust-bbr.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
  sysctl --system >/dev/null
  echo "当前：$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)"
}

change_port() {
  local old new
  old="$(json_get server_port)"
  echo "当前端口：$old"
  read -r -p "新端口：" new
  [[ "$new" =~ ^[0-9]+$ ]] && ((new>=1 && new<=65535)) || { echo "端口无效"; return; }
  backup_config >/dev/null 2>&1 || true
  json_set server_port "$new" int
  if systemctl restart "$SERVICE"; then
    echo "端口已修改：$old -> $new"
  else
    echo "服务重启失败，请检查配置。"
  fi
}

install_reinstall_menu() {
  echo "当前：$("$BIN" --version 2>/dev/null | head -n1 || echo 未安装)"
  echo "1. 安装/更新到官方最新版"
  echo "2. 强制重新安装官方最新版"
  echo "3. 仅检查版本"
  echo "0. 返回"
  read -r -p "选择：" n
  case "$n" in
    1) /usr/local/bin/ssupdate update ;;
    2) /usr/local/bin/ssupdate reinstall ;;
    3) /usr/local/bin/ssupdate check ;;
    0) return ;;
  esac
}

menu() {
  clear
  hr
  echo " Shadowsocks Rust 管理菜单 v1.1.0"
  hr
  echo "1. 查看运行状态"
  echo "2. 启动服务"
  echo "3. 停止服务"
  echo "4. 重启服务"
  echo "5. 查看配置"
  echo "6. 编辑配置"
  echo "7. 生成 ss:// 链接和二维码"
  echo "8. 查看实时日志"
  echo "9. 查看版本"
  echo "10. 检查并更新"
  echo "11. 备份当前配置"
  echo "12. 恢复配置"
  echo "13. 开机自启管理"
  echo "14. 运行环境自检"
  echo "15. 查看服务器连接信息"
  echo "16. 选择 IPv4 / IPv6 出站"
  echo "17. 开启 / 检查 BBR"
  echo "18. 快速修改端口"
  echo "19. 安装 / 重装 Shadowsocks Rust"
  echo "0. 退出"
  hr
}

main() {
  need_root
  while true; do
    menu
    read -r -p "请选择：" choice
    echo
    case "$choice" in
      1) status_service; pause ;;
      2) start_service; pause ;;
      3) stop_service; pause ;;
      4) restart_service; pause ;;
      5) view_config; pause ;;
      6) edit_config; pause ;;
      7) show_ss_url; pause ;;
      8) show_logs ;;
      9) show_version; pause ;;
      10) check_update; pause ;;
      11) backup_config; pause ;;
      12) restore_config; pause ;;
      13) autostart_menu; pause ;;
      14) self_check; pause ;;
      15) connection_info; pause ;;
      16) choose_outbound; pause ;;
      17) bbr_menu; pause ;;
      18) change_port; pause ;;
      19) install_reinstall_menu; pause ;;
      0) exit 0 ;;
      *) echo "无效选择"; sleep 1 ;;
    esac
  done
}

main "$@"
