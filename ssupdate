#!/usr/bin/env bash
set -euo pipefail

REPO_API="https://api.github.com/repos/shadowsocks/shadowsocks-rust/releases/latest"
BIN="/usr/local/bin/ssserver"
SERVICE="shadowsocks-rust.service"
CONFIG="/etc/shadowsocks-rust/config.json"

need_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "错误：请使用 root 权限运行。"; exit 1; }
}

need_cmds() {
  local missing=()
  for c in curl jq tar xz sha256sum install; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  if ((${#missing[@]})); then
    echo "缺少依赖：${missing[*]}"
    echo "Debian/Ubuntu：apt-get update && apt-get install -y curl jq xz-utils coreutils"
    exit 1
  fi
}

arch_asset_suffix() {
  case "$(uname -m)" in
    x86_64|amd64) echo "x86_64-unknown-linux-musl.tar.xz" ;;
    aarch64|arm64) echo "aarch64-unknown-linux-musl.tar.xz" ;;
    *)
      echo "错误：当前仅自动支持 x86_64 / aarch64，检测到：$(uname -m)" >&2
      exit 1
      ;;
  esac
}

latest_info() {
  curl -fsSL --retry 3 --connect-timeout 10 "$REPO_API"
}

latest_version() {
  latest_info | jq -r '.tag_name'
}

current_version() {
  if [[ -x "$BIN" ]]; then
    "$BIN" --version 2>/dev/null | head -n1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true
  fi
}

download_and_install() {
  need_root
  need_cmds

  local json tag ver suffix asset url sha_url td
  json="$(latest_info)"
  tag="$(jq -r '.tag_name' <<<"$json")"
  ver="${tag#v}"
  suffix="$(arch_asset_suffix)"
  asset="shadowsocks-v${ver}.${suffix}"

  url="$(jq -r --arg a "$asset" '.assets[] | select(.name==$a) | .browser_download_url' <<<"$json" | head -n1)"
  sha_url="$(jq -r --arg a "${asset}.sha256" '.assets[] | select(.name==$a) | .browser_download_url' <<<"$json" | head -n1)"

  [[ -n "$url" && "$url" != "null" ]] || { echo "错误：官方 Release 未找到资产：$asset"; exit 1; }
  [[ -n "$sha_url" && "$sha_url" != "null" ]] || { echo "错误：官方 Release 未找到校验文件：${asset}.sha256"; exit 1; }

  td="$(mktemp -d)"
  trap 'rm -rf "$td"' EXIT

  echo "官方最新版本：$tag"
  echo "架构：$(uname -m)"
  echo "下载：$asset"

  curl -fL --retry 3 --connect-timeout 10 -o "$td/$asset" "$url"
  curl -fsSL --retry 3 --connect-timeout 10 -o "$td/$asset.sha256" "$sha_url"

  (
    cd "$td"
    # 官方 sha256 文件通常包含“hash filename”；兼容只含 hash 的情况。
    if grep -q "$asset" "$asset.sha256"; then
      sha256sum -c "$asset.sha256"
    else
      expected="$(awk '{print $1}' "$asset.sha256" | head -n1)"
      actual="$(sha256sum "$asset" | awk '{print $1}')"
      [[ "$expected" == "$actual" ]] || { echo "SHA256 校验失败"; exit 1; }
      echo "$asset: OK"
    fi
  )

  mkdir -p "$td/extract"
  tar -xJf "$td/$asset" -C "$td/extract"
  local newbin
  newbin="$(find "$td/extract" -type f -name ssserver -print -quit)"
  [[ -n "$newbin" ]] || { echo "错误：压缩包内未找到 ssserver"; exit 1; }

  "$newbin" --version >/dev/null 2>&1 || { echo "错误：下载的 ssserver 无法运行"; exit 1; }

  local backup=""
  if [[ -x "$BIN" ]]; then
    backup="/usr/local/bin/ssserver.bak.$(date +%Y%m%d-%H%M%S)"
    cp -a "$BIN" "$backup"
    echo "旧版备份：$backup"
  fi

  install -m 0755 "$newbin" "$BIN"

  if systemctl list-unit-files "$SERVICE" >/dev/null 2>&1 && [[ -f "$CONFIG" ]]; then
    if systemctl restart "$SERVICE"; then
      echo "服务重启成功。"
    else
      echo "错误：更新后服务启动失败。"
      if [[ -n "$backup" && -f "$backup" ]]; then
        cp -a "$backup" "$BIN"
        systemctl restart "$SERVICE" || true
        echo "已回滚旧版 ssserver。"
      fi
      exit 1
    fi
  fi

  echo "ssserver 安装/更新完成：$("$BIN" --version 2>/dev/null | head -n1)"
}

check_cmd() {
  need_cmds
  local cur latest
  cur="$(current_version)"
  latest="$(latest_version)"
  echo "本机版本：${cur:-未安装}"
  echo "官方最新：$latest"
  if [[ -z "$cur" ]]; then
    return 2
  fi
  if [[ "v$cur" == "$latest" ]]; then
    echo "状态：已是最新版本。"
    return 0
  fi
  echo "状态：存在不同版本，可执行 ssupdate update。"
  return 3
}

case "${1:-check}" in
  check)
    check_cmd || true
    ;;
  update|install|reinstall)
    download_and_install
    ;;
  *)
    echo "用法：ssupdate {check|update|install|reinstall}"
    exit 1
    ;;
esac
